--[[--
ColorMatchAI Fusion Plugin
Advanced AI-assisted color matching and transfer.
--]]--

FuRegisterClass("ColorMatchAI", CT_Tool, {
    REGS_Name = "ColorMatchAI",
    REGS_Category = "Color",
    REGS_OpIconString = "CMAI",
    REGS_OpDescription = "AI-assisted color matching and transfer.",
    REG_NoBlendCtrls = true,
    REG_NoObjMatCtrls = true,
    REG_NoMotionBlurCtrls = true,
})

OpenCLCode = [[
// Helper to sample 3D LUT flattened into a 2D image
inline float4 sample_3d_lut_2d(__read_only image2d_t lut_img, int lut_size, float3 color) {
    color = clamp(color, 0.0f, 1.0f);

    float r = color.x * (float)(lut_size - 1);
    float g = color.y * (float)(lut_size - 1);
    float b = color.z * (float)(lut_size - 1);

    int r0 = (int)floor(r); int r1 = min(r0 + 1, lut_size - 1); float fr = r - (float)r0;
    int g0 = (int)floor(g); int g1 = min(g0 + 1, lut_size - 1); float fg = g - (float)g0;
    int b0 = (int)floor(b); int b1 = min(b0 + 1, lut_size - 1); float fb = b - (float)b0;

    int2 p000 = (int2)(b0 * lut_size + r0, g0);
    int2 p100 = (int2)(b0 * lut_size + r1, g0);
    int2 p010 = (int2)(b0 * lut_size + r0, g1);
    int2 p110 = (int2)(b0 * lut_size + r1, g1);
    int2 p001 = (int2)(b1 * lut_size + r0, g0);
    int2 p101 = (int2)(b1 * lut_size + r1, g0);
    int2 p011 = (int2)(b1 * lut_size + r0, g1);
    int2 p111 = (int2)(b1 * lut_size + r1, g1);

    float4 c000 = read_imagef(lut_img, p000);
    float4 c100 = read_imagef(lut_img, p100);
    float4 c010 = read_imagef(lut_img, p010);
    float4 c110 = read_imagef(lut_img, p110);
    float4 c001 = read_imagef(lut_img, p001);
    float4 c101 = read_imagef(lut_img, p101);
    float4 c011 = read_imagef(lut_img, p011);
    float4 c111 = read_imagef(lut_img, p111);

    float4 c00 = mix(c000, c100, fr);
    float4 c10 = mix(c010, c110, fr);
    float4 c01 = mix(c001, c101, fr);
    float4 c11 = mix(c011, c111, fr);

    float4 c0 = mix(c00, c10, fg);
    float4 c1 = mix(c01, c11, fg);

    return mix(c0, c1, fb);
}

__kernel void ColorMatchAIKernel(
    __read_only image2d_t target_img,
    __write_only image2d_t out_img,
    __read_only image2d_t lut_img,
    __read_only image2d_t params_img)
{
    int2 pos = (int2)(get_global_id(0), get_global_id(1));
    int width = get_image_width(target_img);
    int height = get_image_height(target_img);

    if (pos.x >= width || pos.y >= height)
        return;

    // Read parameters from the 2x1 image buffer
    float4 p0 = read_imagef(params_img, (int2)(0, 0));
    float4 p1 = read_imagef(params_img, (int2)(1, 0));

    float strength = p0.x;
    float preserve_skin = p0.y;
    int show_scopes = (int)p0.z;
    int has_lut = (int)p0.w;
    int lut_size = (int)p1.x;

    float4 in_color = read_imagef(target_img, pos);
    float4 out_color = in_color;

    if (has_lut > 0 && strength > 0.0f) {
        float4 mapped_color = sample_3d_lut_2d(lut_img, lut_size, in_color.xyz);
        mapped_color.w = in_color.w;
        out_color = mix(in_color, mapped_color, strength);
    }

    // Simple skin tone preservation mask (Hue targeting)
    if (preserve_skin > 0.0f) {
        float r = in_color.x;
        float g = in_color.y;
        float b = in_color.z;

        float max_val = max(r, max(g, b));
        float min_val = min(r, min(g, b));

        bool is_skin = (r > 0.35f && g > 0.15f && b > 0.1f && r > g && r > b && (max_val - min_val) > 0.05f);
        if (is_skin) {
            out_color = mix(out_color, in_color, preserve_skin);
        }
    }

    // Draw Scopes Overlay (Crude Luma Waveform Approximation)
    if (show_scopes > 0) {
        if (pos.x < 256 && pos.y < 256) {
            out_color = mix(out_color, (float4)(0.1f, 0.1f, 0.1f, 1.0f), 0.8f); // BG
            if (pos.x == 128 || pos.y == 128) out_color = (float4)(0.5f, 0.5f, 0.5f, 1.0f); // Axes
            if (pos.x < 2 || pos.x > 254 || pos.y < 2 || pos.y > 254) out_color = (float4)(0.8f, 0.8f, 0.8f, 1.0f); // Border

            // Render basic waveform by column sampling
            // We sample roughly 64 points in the mapped image column to find density
            int img_col = (int)((float)pos.x / 256.0f * (float)width);
            float target_luma = (float)pos.y / 256.0f;
            int matches = 0;

            int step = max(1, height / 64);
            for (int y = 0; y < height; y += step) {
                float4 p = read_imagef(target_img, (int2)(img_col, y));

                // If lut applied, we need the mapped color for accuracy. For speed, we estimate.
                if (has_lut > 0 && strength > 0.0f) {
                    p = sample_3d_lut_2d(lut_img, lut_size, p.xyz);
                }

                float luma = 0.2126f * p.x + 0.7152f * p.y + 0.0722f * p.z;
                if (fabs(luma - target_luma) < 0.02f) {
                    matches++;
                }
            }

            if (matches > 0) {
                float intensity = min(1.0f, (float)matches * 0.15f);
                out_color = mix(out_color, (float4)(0.2f, 0.8f, 0.2f, 1.0f), intensity);
            }
        }
    }

    write_imagef(out_img, pos, out_color);
}
]]

function Create()
    self.InTarget = self:AddInput("Target Image", "TargetImage", { LINKID_DataType = "Image", LINK_Main = 1 })
    self.InReference = self:AddInput("Reference Image", "ReferenceImage", { LINKID_DataType = "Image", LINK_Main = 2 })

    self.InMode = self:AddInput("Match Mode", "MatchMode", {
        LINKID_DataType = "Number", INPID_InputControl = "ComboControl", INP_Default = 0.0, INP_Integer = true,
        CC_String_0 = "Fast Match", CC_String_1 = "AI Precision",
    })
    self.InStrength = self:AddInput("Match Strength", "MatchStrength", { LINKID_DataType = "Number", INPID_InputControl = "SliderControl", INP_Default = 1.0, INP_MinAllowed = 0.0, INP_MaxAllowed = 1.0 })
    self.InPreserveSkin = self:AddInput("Preserve Skin", "PreserveSkin", { LINKID_DataType = "Number", INPID_InputControl = "SliderControl", INP_Default = 0.0, INP_MinAllowed = 0.0, INP_MaxAllowed = 1.0 })
    self.InShowScopes = self:AddInput("Show Scopes Overlay", "ShowScopes", { LINKID_DataType = "Number", INPID_InputControl = "CheckboxControl", INP_Default = 0.0, INP_Integer = true })

    self.InAnalyze = self:AddInput("Analyze Frame", "Analyze", { LINKID_DataType = "Number", INPID_InputControl = "ButtonControl", INP_Integer = false, BTNCS_Execute = "btn_analyze_clicked" })
    self.InExport = self:AddInput("Export LUT (.cube)", "Export", { LINKID_DataType = "Number", INPID_InputControl = "ButtonControl", INP_Integer = false, BTNCS_Execute = "btn_export_clicked" })

    -- Invisible dummy control to force cache invalidation upon button click
    self.InDummyTrigger = self:AddInput("DummyTrigger", "DummyTrigger", { LINKID_DataType = "Number", INPID_InputControl = "SliderControl", INP_Default = 0.0, ICS_ControlPage = "Hidden" })

    self.OutImage = self:AddOutput("Output", "Output", { LINKID_DataType = "Image", LINK_Main = 1 })

    self.DoAnalyzeNextFrame = false
    self.DoExportNextFrame = false
    self.LoadedLUTImage = nil
    self.LoadedLUTSize = 0
    self.LastLUTModifiedTime = 0

    -- Generate unique ID for this node instance to prevent file collisions
    self.UniqueID = string.format("%04x", math.random(10000, 99999))
    local temp_dir = os.getenv("TEMP")
    if not temp_dir then temp_dir = "/tmp" end

    self.TgtPath = temp_dir .. "/ColorMatchAI_tgt_" .. self.UniqueID .. ".ppm"
    self.RefPath = temp_dir .. "/ColorMatchAI_ref_" .. self.UniqueID .. ".ppm"
    self.LUTPath = temp_dir .. "/ColorMatchAI_out_" .. self.UniqueID .. ".cube"
    self.JSONPath = temp_dir .. "/ColorMatchAI_out_" .. self.UniqueID .. ".json"
end

function FileExists(name)
    local f = io.open(name, "r")
    if f ~= nil then io.close(f) return true else return false end
end

function NotifyChanged(inp, param, time)
    if inp == self.InAnalyze then
        print("Analyze requested. Next frame processed will update the color match.")
        self.DoAnalyzeNextFrame = true
        self.InDummyTrigger:SetSource(Number(self.InDummyTrigger:GetValue(time).Value + 1), time)
    elseif inp == self.InExport then
        -- Execute file dialog synchronously on the UI thread, NOT in Process()
        if not FileExists(self.LUTPath) then
            print("Error: No LUT has been generated yet. Please click Analyze first.")
            return
        end

        local out_path = fu:RequestFile("ColorMatchAI_Export.cube", self.LUTPath, {
            FReqS_Filter = "Cube LUTs (*.cube)|*.cube",
            FReqS_Title = "Save Generated LUT",
            FReqB_Save = true
        })

        if out_path then
            local is_windows = (package.config:sub(1,1) == "\\")
            if is_windows then
                os.execute('copy "' .. self.LUTPath:gsub("/", "\\") .. '" "' .. out_path:gsub("/", "\\") .. '"')
            else
                os.execute('cp "' .. self.LUTPath .. '" "' .. out_path .. '"')
            end
            print("LUT exported successfully to: " .. out_path)
        end
    end
end

-- Fast write of image to PPM format for Python to read
function SaveImageToPPM(img, filename)
    local width = img.DataWindow:Width()
    local height = img.DataWindow:Height()

    -- Downsample for speed if needed (e.g., max 512x512)
    local step = math.max(1, math.floor(math.max(width, height) / 512))
    local out_w = math.floor(width / step)
    local out_h = math.floor(height / step)

    local f = io.open(filename, "wb")
    if not f then return false end

    f:write("P6\n" .. out_w .. " " .. out_h .. "\n255\n")

    local p = Pixel()
    -- Lua strings are 8-bit clean, but concat in a loop is slow.
    -- We write row by row.
    for y = 0, height - 1, step do
        local row = {}
        for x = 0, width - 1, step do
            img:GetPixel(x, height - 1 - y, p) -- Resolve Y is bottom-up, PPM is top-down
            local r = math.max(0, math.min(255, math.floor(p.R * 255)))
            local g = math.max(0, math.min(255, math.floor(p.G * 255)))
            local b = math.max(0, math.min(255, math.floor(p.B * 255)))
            table.insert(row, string.char(r, g, b))
        end
        f:write(table.concat(row))
    end
    f:close()
    return true
end

-- Parse .cube file and load it into a 2D image buffer for OpenCL
function ParseCubeTo2D(filename)
    if not FileExists(filename) then return nil, 0 end

    local size = 0
    local r_arr = {}
    local g_arr = {}
    local b_arr = {}

    local f = io.open(filename, "r")
    for line in f:lines() do
        if string.find(line, "LUT_3D_SIZE") then
            size = tonumber(string.match(line, "%d+"))
        elseif not string.find(line, "[A-Z]") and line ~= "" then
            local r, g, b = string.match(line, "([%d%.%-]+)%s+([%d%.%-]+)%s+([%d%.%-]+)")
            if r and g and b then
                table.insert(r_arr, tonumber(r))
                table.insert(g_arr, tonumber(g))
                table.insert(b_arr, tonumber(b))
            end
        end
    end
    f:close()

    if size == 0 or #r_arr == 0 then return nil, 0 end

    -- Create 2D Image buffer (width = size * size, height = size)
    local img = Image({IMG_Width = size * size, IMG_Height = size, IMG_Depth = 4}) -- Float32 depth not available via simple constructor usually, but we set values directly
    local p = Pixel()
    p.A = 1.0

    local idx = 1
    for b_idx = 0, size - 1 do
        for g_idx = 0, size - 1 do
            for r_idx = 0, size - 1 do
                p.R = r_arr[idx]
                p.G = g_arr[idx]
                p.B = b_arr[idx]

                local x = b_idx * size + r_idx
                local y = g_idx

                -- Ensure valid coordinates before setting
                if x >= 0 and x < size*size and y >= 0 and y < size then
                    img:SetPixel(x, y, p)
                end
                idx = idx + 1
            end
        end
    end

    return img, size
end

function Process(req)
    local target = self.InTarget:GetValue(req)
    local ref = self.InReference:GetValue(req)
    local strength = self.InStrength:GetValue(req).Value
    local skin = self.InPreserveSkin:GetValue(req).Value
    local show_scopes = self.InShowScopes:GetValue(req).Value
    local match_mode = self.InMode:GetValue(req).Value

    if target == nil then return end

    local out = Image({IMG_Like = target})

    local is_windows = (package.config:sub(1,1) == "\\")

    if self.DoAnalyzeNextFrame and ref ~= nil then
        self.DoAnalyzeNextFrame = false
        print("Saving downsampled frames to disk for Python engine...")

        SaveImageToPPM(target, self.TgtPath)
        SaveImageToPPM(ref, self.RefPath)

        local mode_str = "Fast"
        if match_mode == 1.0 then mode_str = "AI_Precision" end

        local script_dir = ""
        local engine_path = ""
        if is_windows then
            script_dir = os.getenv("PROGRAMDATA") .. "\\Blackmagic Design\\DaVinci Resolve\\Fusion\\Scripts\\Utility\\ColorMatchAI\\"
            engine_path = script_dir .. "ColorMatchAI_Engine.py"
        else
            script_dir = "/Library/Application Support/Blackmagic Design/DaVinci Resolve/Fusion/Scripts/Utility/ColorMatchAI/"
            engine_path = script_dir .. "ColorMatchAI_Engine.py"
        end

        if not FileExists(engine_path) then
             engine_path = "./Scripts/ColorMatchAI_Engine.py"
        end

        print("Invoking Python Engine: " .. engine_path)
        local cmd = string.format('python "%s" --ref "%s" --tgt "%s" --out_lut "%s" --out_json "%s" --mode "%s"',
            engine_path, self.RefPath, self.TgtPath, self.LUTPath, self.JSONPath, mode_str)

        local result = os.execute(cmd)
        if result == 0 or result == true then
             print("Analysis successful. Loading LUT into 2D memory map...")
             local img, size = ParseCubeTo2D(self.LUTPath)
             if img then
                 self.LoadedLUTImage = img
                 self.LoadedLUTSize = size

                 local attr = lfs and lfs.attributes(self.LUTPath)
                 if attr then self.LastLUTModifiedTime = attr.modification end

                 print("LUT successfully loaded to GPU.")
             else
                 print("Error: Failed to parse generated LUT.")
             end
        else
             print("Error: Python Engine failed. Ensure python, numpy, and opencv-python are installed.")
        end
    end

    -- State persistence check: If self.LoadedLUTImage is nil (e.g. new frame / script reload) but LUT exists, load it
    if self.LoadedLUTImage == nil and FileExists(self.LUTPath) then
        local img, size = ParseCubeTo2D(self.LUTPath)
        if img then
            self.LoadedLUTImage = img
            self.LoadedLUTSize = size
        end
    end

    if not req:IsPreCalc() then
        local has_lut_val = 0
        local lut_size_val = 0

        if self.LoadedLUTImage ~= nil then
            has_lut_val = 1
            lut_size_val = self.LoadedLUTSize
        end

        local node = DVIPComputeNode(req, "ColorMatchAIKernel", OpenCLCode, "", "")

        node:AddInput("target_img", target)

        if self.LoadedLUTImage ~= nil then
            node:AddInput("lut_img", self.LoadedLUTImage)
        else
            -- Bind a dummy 1x1 image to prevent OpenCL crash
            local dummy_lut = Image({IMG_Width = 1, IMG_Height = 1, IMG_Depth = 4})
            node:AddInput("lut_img", dummy_lut)
        end

        -- Pack parameters into a 2x1 Image Buffer
        local params_img = Image({IMG_Width = 2, IMG_Height = 1, IMG_Depth = 4})
        local p = Pixel()

        p.R = strength
        p.G = skin
        p.B = show_scopes
        p.A = has_lut_val
        params_img:SetPixel(0, 0, p)

        p.R = lut_size_val
        p.G = 0.0
        p.B = 0.0
        p.A = 0.0
        params_img:SetPixel(1, 0, p)

        node:AddInput("params_img", params_img)

        node:AddOutput("out_img", out)

        local ok = node:RunSession(req)
        if not ok then
            out = nil
            print("ColorMatchAI OpenCL Kernel failed")
        end
    end

    self.OutImage:Set(req, out)
end
